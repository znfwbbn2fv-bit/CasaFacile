{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "casafacile-family-beta",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "routes": [{"pattern": "REPLACE_WITH_PROTECTED_BETA_HOSTNAME", "custom_domain": true}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casafacile-family-beta",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "casafacile-family-backups-beta"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
